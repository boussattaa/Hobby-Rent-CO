# ==============================================================================
# HobbyRent Environment Configuration Template
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site & App URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://hobby-rent-co.vercel.app

# Stripe Payments & Identity Verification
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# Email & AI & Maps
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM="HobbyRent <notifications@hobbyrent.com>"
EMAIL_REPLY_TO=support@hobbyrent.com
OPENAI_API_KEY=<your-openai-api-key>
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Admin & Cron
ADMIN_EMAIL=admin@hobbyrent.com
CRON_SECRET=replace_with_random_cron_secret
